{
  "llm": {
    "provider": "lmstudio",
    "api_key": null,
    "base_url": "http://127.0.0.1:1234",
    "model": "qwen/qwen3.5-9b",
    "timeout_secs": 120,
    "json_mode": false
  },
  "react": {
    "max_steps": 16,
    "verbose": false,
    "show_context_metrics": true,
    "show_task_execution": true,
    "show_tool_output": true,
    "session_max_turns": 8,
    "two_phase": true,
    "max_steps_plan": 4,
    "advance": {
      "enabled": true,
      "max_phases": 8,
      "clear_session_each_phase": true,
      "max_note_chars": 1500,
      "show_phases": true
    }
  },
  "log": {
    "context_metrics": "logs/context.jsonl",
    "rotation": {
      "max_bytes": 10485760,
      "max_files": 5
    }
  },
  "tools": {
    "packs": {
      "basic": true,
      "coding": true
    },
    "brave_search": {
      "api_key": null,
      "max_results": 5,
      "fetch_content": false,
      "max_content_chars": 2048
    }
  },
  "memory": {
    "local": true,
    "backends": [],
    "providers": {
      "mempalace": {
        "protocol": "mcp_stdio",
        "command": "C:\\Python312\\python.exe",
        "args": ["-m", "mempalace.mcp_server"],
        "agent_name": "harness-seed",
        "wing_from_cwd": true,
        "init_wing_if_missing": true,
        "timeout_secs": 30,
        "wing": null,
        "room": null
      }
    },
    "recent_work": {
      "enabled": true,
      "max_entries": 3,
      "max_chars": 800
    },
    "search": {
      "enabled": true,
      "top_k": 5,
      "max_chars": 3200
    },
    "rag": {
      "router": "llm",
      "max_queries": 3
    },
    "recall_max_rounds": 2
  }
}
